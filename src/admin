backend:
  name: git-gateway
  branch: main
media_folder: "src/images"
public_folder: "/images"

collections:
  - name: "site"
    label: "Site Settings"
    files:
      - label: "Global"
        name: "global"
        file: "src/data/site.yml"
        fields:
          - { label: "Site Title", name: "title", widget: "string" }
          - { label: "Description", name: "description", widget: "string" }
          - { label: "Logo", name: "logo", widget: "image" }
          - { label: "Hero Image", name: "hero_image", widget: "image" }
          - { label: "Year", name: "year", widget: "string", default: "2025" }
  - name: "hero"
    label: "Hero Section"
    files:
      - label: "Hero"
        name: "hero"
        file: "src/data/hero.yml"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - { label: "Description", name: "description", widget: "string" }
          - { label: "CTA Button", name: "cta", widget: "string" }
  - name: "about"
    label: "About Section"
    files:
      - label: "About"
        name: "about"
        file: "src/data/about.yml"
        fields:
          - { label: "Image", name: "image", widget: "image" }
          - { label: "Heading", name: "heading", widget: "string" }
          - { label: "Story", name: "story", widget: "text" }
          - { label: "Mission", name: "mission", widget: "string" }
          - label: "Values"
            name: "values"
            widget: "list"
            fields:
              - { label: "Value", name: "item", widget: "string" }
  - name: "products"
    label: "Products"
    files:
      - label: "Products"
        name: "products"
        file: "src/data/products.yml"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - label: Products
            name: items
            widget: list
            fields:
              - { label: "Name", name: "name", widget: "string" }
              - { label: "Image", name: "image", widget: "image" }
              - { label: "Description", name: "description", widget: "text" }
  - name: "why"
    label: "Why Choose Us"
    files:
      - label: "Why"
        name: "why"
        file: "src/data/why.yml"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - label: "Reasons"
            name: "reasons"
            widget: "list"
            fields:
              - { label: "Title", name: "title", widget: "string" }
              - { label: "Icon", name: "icon", widget: "image" }
              - { label: "Text", name: "text", widget: "string" }
  - name: "testimonials"
    label: "Testimonials"
    files:
      - label: "Testimonials"
        name: "testimonials"
        file: "src/data/testimonials.yml"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - label: Testimonials
            name: items
            widget: list
            fields:
              - { label: "Name", name: "name", widget: "string" }
              - { label: "Avatar", name: "avatar", widget: "image" }
              - { label: "Quote", name: "quote", widget: "text" }
              - { label: "Title", name: "title", widget: "string" }
  - name: "faqs"
    label: "FAQs"
    files:
      - label: "FAQs"
        name: "faqs"
        file: "src/data/faqs.yml"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - label: FAQs
            name: items
            widget: list
            fields:
              - { label: "Question", name: "question", widget: "string" }
              - { label: "Answer", name: "answer", widget: "text" }
  - name: "contact"
    label: "Contact"
    files:
      - label: "Contact"
        name: "contact"
        file: "src/data/contact.yml"
        fields:
          - { label: "Title", name: "title", widget: "string" }
          - { label: "Button", name: "button", widget: "string" }
          - { label: "Email", name: "email", widget: "string" }
          - { label: "WhatsApp", name: "whatsapp", widget: "string" }
          - { label: "Map Embed URL", name: "map_embed", widget: "string" }
