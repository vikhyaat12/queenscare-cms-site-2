  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Queens Care Laboratories: Premium health and wellness products. Enhancing Health & Life Naturally.">
  <meta property="og:title" content="Queens Care Laboratories" />
  <meta property="og:description" content="Premium health and wellness products. Enhancing Health & Life Naturally." />
