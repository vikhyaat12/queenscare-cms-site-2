  <!-- HEADER / NAVIGATION -->
  <header class="navbar">
    <div class="container nav-content">
      <a href="#hero" class="logo">
        <img src="/images/logo-qcl.png" alt="Queens Care Laboratories Logo" />
        <span>Queens Care Laboratories</span>
      </a>
      <nav>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#products">Products</a></li>
          <li><a href="#why">Why Choose Us</a></li>
          <li><a href="#testimonials">Testimonials</a></li>
          <li><a href="#faqs">FAQs</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section id="hero" class="hero-section">
    <div class="hero-bg"></div>
    <div class="container hero-content">
      <h1>Enhancing Health &amp; Life <span class="highlight">Naturally</span></h1>
      <p class="hero-desc">Premium health & wellness products trusted by doctors and families.</p>
      <a href="#products" class="cta-btn">Explore Products</a>
    </div>
  </section>

  <!-- ABOUT US -->
  <section id="about" class="about-section section">
    <div class="container about-content">
      <div class="about-img">
        <img src="/images/about-lab.jpg" alt="Modern Laboratory" />
      </div>
      <div class="about-text">
        <h2>Our Story</h2>
        <p>Founded in <strong>2010</strong>, Queens Care Laboratories is dedicated to enhancing your well-being through innovative, high-quality health and wellness solutions.</p>
        <h3>Mission</h3>
        <p>To deliver premium, safe, and effective products that improve the quality of life for our customers.</p>
        <h3>Values</h3>
        <ul>
          <li>Innovation in healthcare</li>
          <li>Premium packaging for safety & freshness</li>
          <li>Customer-centric approach</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="products" class="products-section section">
    <div class="container">
      <h2 class="section-title">Our Products</h2>
      <div class="products-grid">
        <!-- Product 1 -->
        <div class="product-card">
          <img src="/images/product-likeoq.jpg" alt="Likeoq Multivitamin Syrup" />
          <h3>Likeoq Multivitamin Syrup</h3>
          <p>Complete multivitamin syrup for daily wellness. Tasty, doctor-formulated, and suitable for all ages.</p>
        </div>
        <!-- Product 2 -->
        <div class="product-card">
          <img src="/images/product-placeholder1.jpg" alt="Herbal Immunity Capsules" />
          <h3>Herbal Immunity Capsules</h3>
          <p>Natural blend to strengthen immunity. 100% herbal, safe, and effective for the whole family.</p>
        </div>
        <!-- Product 3 -->
        <div class="product-card">
          <img src="/images/product-placeholder2.jpg" alt="Kids Growth Tonic" />
          <h3>Kids Growth Tonic</h3>
          <p>Specially designed tonic to support healthy growth and development in children.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section id="why" class="why-section section">
    <div class="container">
      <h2 class="section-title">Why Choose Us</h2>
      <div class="why-grid">
        <div class="why-card">
          <img src="/images/why-doctor.png" alt="Doctor Recommended" />
          <h4>Doctor Recommended</h4>
          <p>Trusted by healthcare professionals nationwide.</p>
        </div>
        <div class="why-card">
          <img src="/images/why-quality.png" alt="Premium Quality" />
          <h4>Premium Quality</h4>
          <p>We use only the highest quality ingredients and processes.</p>
        </div>
        <div class="why-card">
          <img src="/images/why-packaging.png" alt="Attractive Packaging" />
          <h4>Attractive Packaging</h4>
          <p>Innovative, safe, and visually appealing product packaging.</p>
        </div>
        <div class="why-card">
          <img src="/images/why-customer.png" alt="Customer Satisfaction" />
          <h4>Customer Satisfaction</h4>
          <p>Thousands of happy customers and a dedicated support team.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section id="testimonials" class="testimonials-section section">
    <div class="container">
      <h2 class="section-title">Testimonials</h2>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <img src="/images/testimonial-customer1.jpg" alt="Dr. Priya Sharma" class="testimonial-avatar" />
          <blockquote>“Queens Care’s Likeoq Syrup is my top recommendation for families. The quality and results are outstanding.”</blockquote>
          <cite>Dr. Priya Sharma<br><span>Paediatrician</span></cite>
        </div>
        <div class="testimonial-card">
          <img src="/images/testimonial-customer2.jpg" alt="Mr. Rajesh Kumar" class="testimonial-avatar" />
          <blockquote>“We love the premium packaging and effectiveness of the products. Excellent for my family’s health!”</blockquote>
          <cite>Rajesh Kumar<br><span>Customer</span></cite>
        </div>
        <div class="testimonial-card">
          <img src="/images/testimonial-customer3.jpg" alt="Dr. Neha Agarwal" class="testimonial-avatar" />
          <blockquote>“Innovative and trustworthy! Queens Care Labs always delivers top-notch wellness solutions.”</blockquote>
          <cite>Dr. Neha Agarwal<br><span>General Physician</span></cite>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faqs" class="faq-section section">
    <div class="container">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-question">Are Queens Care products safe for daily use?</button>
          <div class="faq-answer">Yes, all our products are formulated with safe, clinically tested ingredients, suitable for daily use as directed.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">Where can I buy your products?</button>
          <div class="faq-answer">Our products are available at leading pharmacies, healthcare stores, and online platforms.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">Do you offer products for children?</button>
          <div class="faq-answer">Yes, we have specially formulated products for children, including our best-selling Kids Growth Tonic.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">How can I contact customer support?</button>
          <div class="faq-answer">You can contact us via email, WhatsApp, or the contact form below for any assistance.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT US -->
  <section id="contact" class="contact-section section">
    <div class="container contact-content">
      <div class="contact-form-block">
        <h2>Contact Us</h2>
        <form class="contact-form" name="contact" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="contact" />
          <label>
            Name:
            <input type="text" name="name" required />
          </label>
          <label>
            Email:
            <input type="email" name="email" required />
          </label>
          <label>
            Message:
            <textarea name="message" rows="4" required></textarea>
          </label>
          <button type="submit" class="cta-btn">Send Message</button>
        </form>
        <div class="contact-info">
          <p><strong>Email:</strong> <a href="mailto:info@queenscarelabs.com">info@queenscarelabs.com</a></p>
          <p><strong>WhatsApp:</strong> <a href="https://wa.me/9760006841" target="_blank">Chat Now</a></p>
        </div>
      </div>
      <div class="contact-map-block">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3558.1234567890!2d75.789012!3d26.912345!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0:0x0!2sQueens%20Care%20Laboratories!5e0!3m2!1sen!2sin!4v1682600000000!5m2!1sen!2sin" width="100%" height="320" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

